DB_HOST='localhost'
DB_USER='goflow_user'
DB_PASS='goflow@pwd'
DB_NAME='goflow'
DB_PORT=5432
# SSL to Postgres: disable (default), require, verify-ca, verify-full
# DB_SSLMODE=require
# Password for the dockerized Postgres (docker compose) — goflow123 by default
# POSTGRES_PASSWORD=change_me
SERVER_PATH='http://127.0.0.1:8080'
PORT='8080'

CLIENT_DEV_PORT='8282'

# Queue Settings
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF_BASE=1s
QUEUE_RETRY_MAX_BACKOFF=5m
QUEUE_RETRY_SCHEDULER_INTERVAL=5s
QUEUE_STATS_UPDATE_INTERVAL=30s
QUEUE_CLEANUP_OLDER_THAN=24h

# Server Configuration
# SERVER_PORT: application port (locally, and port published by docker compose)
SERVER_PORT=8080
# GRPC_PORT: Zeebe/gRPC port published by Docker (useful to isolate a scale cluster)
GRPC_PORT=26500
# FRONTEND_PORT: published port of the dockerized frontend (nginx)
FRONTEND_PORT=3000
QUEUE_WORKERS=10

# Token signing key — must be replaced (the server rejects 'change_me').
# Once set, BpmnGo runs in production mode. Without any .env at all, it runs in
# demo mode with a generated key (for trying out, never for production).
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY='change_me'
# BPMNGO_ENV=production   # or demo; default: production if
#                         # JWT_SECRET_KEY is set, demo otherwise

# Super User (created at startup if it doesn't exist — also used by docker compose)
# CREATE_SUPER_USER=false: don't create the super user at startup (once
# it exists, or if accounts are managed otherwise). Absent = true.
CREATE_SUPER_USER=true
SUPER_USER_NAME=admin
SUPER_USER_EMAIL=admin@bpmngo.com
SUPER_USER_PASSWORD=change_me

# OIDC (optional) — set all three to accept bearer tokens from an external
# identity provider (Keycloak, Auth0, Azure AD, ...) alongside the built-in
# JWT login. Leave unset to keep OIDC disabled (default).
# OIDC_ISSUER=https://your-idp.example.com/realms/bpmngo
# OIDC_AUDIENCE=bpmngo-api
# OIDC_JWKS_URL=https://your-idp.example.com/realms/bpmngo/protocol/openid-connect/certs

# Observability — token required on GET /metrics (Authorization: Bearer <token>).
# Empty = /metrics readable without authentication.
# METRICS_TOKEN=change_me

# Retention — automatically deletes instances finished more than
# N days ago (related historic_*, audit_logs and projections). Empty or 0 = keep everything.
# RETENTION_DAYS=365
# RETENTION_INTERVAL=1h
# RETENTION_BATCH_SIZE=500

# Kafka / Redpanda (docker compose): only for WRITE_PATH=partitioned or
# EVENT_LOG=shadow. In direct mode (default), neither Kafka nor Redpanda. Otherwise:
# COMPOSE_PROFILES=kafka       # starts Redpanda
# KAFKA_BROKERS=redpanda:9092
# EVENT_LOG=off                # or shadow: every engine event is also
#                              # written to Kafka and projected; only used by
#                              # diagnostic routes /engine-rest/eventlog/*
# KAFKA_REPLICATION_FACTOR=1   # copies per partition, at topic creation
# Write path:
#   direct (default) — each command executes where it arrives (Postgres locks)
#   partitioned      — like Camunda 8: each command of an instance goes through
#                      the Kafka partition of the instance, executed by the only
#                      BpmnGo instance that owns that partition
# WRITE_PATH=direct
# KAFKA_PARTITIONS=12          # fixed once instances are created
# COMMAND_TIMEOUT=30s          # max wait for a command's response
# REDPANDA_MEMORY=1G
# REDPANDA_SMP=1
# POSTGRES_BIND=127.0.0.1      # 0.0.0.0 to expose Postgres outside the machine

# FEEL expressions ("=" prefix, Camunda 8 style) and DMN tables:
#   shadow (default) — the legacy engine (FEEL→CEL translation) decides, the
#                      native FEEL engine runs in parallel and each discrepancy
#                      is logged + counted (bpmngo_feel_shadow_mismatches_total)
#   feel             — the native FEEL engine decides
#   cel              — legacy engine only
# FEEL_MODE=shadow
# Exclusive gateway with several conditions true: camunda (default) takes the
# last true flow in the order of the sequenceFlow elements of the file, as
# Camunda 8 does; bpmn takes the first, in the gateway's <outgoing> order
# (else file order), as the BPMN 2.0 standard says.
# EXCLUSIVE_GATEWAY_ORDER=camunda

# Keys in /v2 (Camunda 8) API responses:
#   int (default) — the gRPC int64 key, as a string ("125"), like Camunda 8:
#                   a client sees the same key in gRPC and REST
#   uuid          — legacy BpmnGo format, explicitly available
# /v2 accepts both forms as input, regardless of this setting; the
# /engine-rest (Camunda 7) API remains in UUID.
# REST_KEYS=int

# Postgres connections: DB_MAX_OPEN_CONNS per BpmnGo instance (default 80);
# POSTGRES_MAX_CONNECTIONS (default 200) must cover DB_MAX_OPEN_CONNS × the
# number of BpmnGo instances, plus a margin for admin.
# DB_MAX_OPEN_CONNS=80
# Query dispatch: cache_statement (default) prepares each query once
# per connection and reuses its plan; cache_describe replans on each call
# (only behind a pooler without prepared statement support).
# DB_QUERY_EXEC_MODE=cache_statement
# Maximum top-level runtime executions in flight. Nested subprocess/MI work
# reuses its parent slot. Default: 4 × GOMAXPROCS (minimum 4).
# RUNTIME_MAX_CONCURRENCY=8
# Foreground concurrency retained at a hard archive backlog. Default: one
# quarter of RUNTIME_MAX_CONCURRENCY, minimum 1.
# RUNTIME_MIN_CONCURRENCY=2
# Admission is halved at the soft threshold and reduced to the minimum at the
# hard threshold so PostgreSQL and the archiver keep making progress.
# ARCHIVER_BACKLOG_SOFT_LIMIT=1000
# ARCHIVER_BACKLOG_HARD_LIMIT=5000
# POSTGRES_MAX_CONNECTIONS=200
# PostgreSQL memory/observability defaults assume a container/VM with at
# least 768 MiB available. The benchmark override grants 768 MiB so the
# whole BpmnGo stack remains inside its 2 GiB test budget.
# POSTGRES_MEMORY_LIMIT=768m
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=128MB
# POSTGRES_MAX_WAL_SIZE=2GB
# Multi-replica profile: server connections kept by PgBouncer.
# PGBOUNCER_POOL_SIZE=80
# Scale mode defaults: DB_MAX_OPEN_CONNS=40 and DB_MAX_IDLE_CONNS=10 per replica.

# Node number (0..1023) carried by the BIGINT engine keys. Unset (default),
# each BpmnGo instance claims a free one at boot (Postgres advisory lock),
# so replicas never issue the same keys. Set it only to pin a number; then
# every concurrently running instance must have a different one.
# ENGINE_NODE_ID=
# POSTGRES_PORT=5432
# Citus override (docker-compose.citus.yml)
# CITUS_COORDINATOR_PORT=5433