      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s5_di" bpmnElement="s5">
        <dc:Bounds x="788" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s6_di" bpmnElement="s6">
        <dc:Bounds x="938" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s7_di" bpmnElement="s7">
