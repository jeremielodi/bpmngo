      <bpmndi:BPMNShape id="Participant_feel_strings_di" bpmnElement="Participant_feel_strings" isHorizontal="true">
        <dc:Bounds x="0" y="380" width="1646" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_start_di" bpmnElement="s_start">
        <dc:Bounds x="70" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1">
