<?xml version="1.0" encoding="UTF-8"?>
<!-- Shapes every BPMN engine meets in real models: loops, nested and
     interrupted sub-processes, terminate ends, wide and nested parallelism,
     inclusive joins, links, several end events, script and DMN tasks,
     escalations and errors thrown from sub-processes, event-based gateways,
     nested correlation keys, multi-instance sub-processes with a gateway
     inside, non-interrupting boundaries firing twice, call activities. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="robustness" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:error id="Err_risk" name="Risk" errorCode="RISK"/>
  <bpmn:error id="Err_end" name="Ended badly" errorCode="ERR_END"/>
  <bpmn:escalation id="Esc_rb" name="Needs a look" escalationCode="LOOK"/>
  <bpmn:signal id="Sig_rb" name="rb-go"/>
  <bpmn:message id="Msg_rb_nested" name="rb-nested">
    <bpmn:extensionElements><zeebe:subscription correlationKey="=order.id"/></bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_rb_note" name="rb-note">
    <bpmn:extensionElements><zeebe:subscription correlationKey="=ref"/></bpmn:extensionElements>
  </bpmn:message>

  <!-- 1. A retry loop: the flow goes back to the task until ok. -->
  <bpmn:process id="rb_loop" isExecutable="true">
    <bpmn:startEvent id="lo_start"/>
    <bpmn:sequenceFlow id="lo_f0" sourceRef="lo_start" targetRef="lo_merge"/>
    <bpmn:exclusiveGateway id="lo_merge"/>
    <bpmn:sequenceFlow id="lo_f1" sourceRef="lo_merge" targetRef="lo_try"/>
    <bpmn:serviceTask id="lo_try"><bpmn:extensionElements><zeebe:taskDefinition type="rb-attempt"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="lo_f2" sourceRef="lo_try" targetRef="lo_check"/>
    <bpmn:exclusiveGateway id="lo_check" default="lo_again"/>
    <bpmn:sequenceFlow id="lo_done" sourceRef="lo_check" targetRef="lo_end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="lo_again" sourceRef="lo_check" targetRef="lo_merge"/>
    <bpmn:endEvent id="lo_end"/>
  </bpmn:process>

  <!-- 2. Sub-process in a sub-process. -->
  <bpmn:process id="rb_nested_sub" isExecutable="true">
    <bpmn:startEvent id="ns_start"/>
    <bpmn:sequenceFlow id="ns_f0" sourceRef="ns_start" targetRef="ns_outer"/>
    <bpmn:subProcess id="ns_outer">
      <bpmn:startEvent id="ns_o_start"/>
      <bpmn:sequenceFlow id="ns_o_f0" sourceRef="ns_o_start" targetRef="ns_inner"/>
      <bpmn:subProcess id="ns_inner">
        <bpmn:startEvent id="ns_i_start"/>
        <bpmn:sequenceFlow id="ns_i_f0" sourceRef="ns_i_start" targetRef="ns_i_task"/>
        <bpmn:serviceTask id="ns_i_task"><bpmn:extensionElements><zeebe:taskDefinition type="rb-inner"/></bpmn:extensionElements></bpmn:serviceTask>
        <bpmn:sequenceFlow id="ns_i_f1" sourceRef="ns_i_task" targetRef="ns_i_end"/>
        <bpmn:endEvent id="ns_i_end"/>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="ns_o_f1" sourceRef="ns_inner" targetRef="ns_o_task"/>
      <bpmn:serviceTask id="ns_o_task"><bpmn:extensionElements><zeebe:taskDefinition type="rb-middle"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="ns_o_f2" sourceRef="ns_o_task" targetRef="ns_o_end"/>
      <bpmn:endEvent id="ns_o_end"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="ns_f1" sourceRef="ns_outer" targetRef="ns_task"/>
    <bpmn:serviceTask id="ns_task"><bpmn:extensionElements><zeebe:taskDefinition type="rb-outer"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="ns_f2" sourceRef="ns_task" targetRef="ns_end"/>
    <bpmn:endEvent id="ns_end"/>
  </bpmn:process>

  <!-- 3. A job error caught by an error boundary on the sub-process. -->
  <bpmn:process id="rb_sub_error" isExecutable="true">
    <bpmn:startEvent id="se_start"/>
    <bpmn:sequenceFlow id="se_f0" sourceRef="se_start" targetRef="se_sub"/>
    <bpmn:subProcess id="se_sub">
      <bpmn:startEvent id="se_s_start"/>
      <bpmn:sequenceFlow id="se_s_f0" sourceRef="se_s_start" targetRef="se_risky"/>
      <bpmn:serviceTask id="se_risky"><bpmn:extensionElements><zeebe:taskDefinition type="rb-risky"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="se_s_f1" sourceRef="se_risky" targetRef="se_s_end"/>
      <bpmn:endEvent id="se_s_end"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="se_catch" attachedToRef="se_sub"><bpmn:errorEventDefinition errorRef="Err_risk"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="se_f1" sourceRef="se_sub" targetRef="se_end"/>
    <bpmn:sequenceFlow id="se_f2" sourceRef="se_catch" targetRef="se_handle"/>
    <bpmn:serviceTask id="se_handle"><bpmn:extensionElements><zeebe:taskDefinition type="rb-handle"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="se_f3" sourceRef="se_handle" targetRef="se_end2"/>
    <bpmn:endEvent id="se_end"/>
    <bpmn:endEvent id="se_end2"/>
  </bpmn:process>

  <!-- 4. An interrupting timer on the sub-process cuts the slow task inside. -->
  <bpmn:process id="rb_sub_timer" isExecutable="true">
    <bpmn:startEvent id="st_start"/>
    <bpmn:sequenceFlow id="st_f0" sourceRef="st_start" targetRef="st_sub"/>
    <bpmn:subProcess id="st_sub">
      <bpmn:startEvent id="st_s_start"/>
      <bpmn:sequenceFlow id="st_s_f0" sourceRef="st_s_start" targetRef="st_slow"/>
      <bpmn:serviceTask id="st_slow"><bpmn:extensionElements><zeebe:taskDefinition type="rb-slow"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="st_s_f1" sourceRef="st_slow" targetRef="st_s_end"/>
      <bpmn:endEvent id="st_s_end"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="st_timer" attachedToRef="st_sub">
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="st_f1" sourceRef="st_sub" targetRef="st_end"/>
    <bpmn:sequenceFlow id="st_f2" sourceRef="st_timer" targetRef="st_timeout"/>
    <bpmn:serviceTask id="st_timeout"><bpmn:extensionElements><zeebe:taskDefinition type="rb-timeout"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="st_f3" sourceRef="st_timeout" targetRef="st_end2"/>
    <bpmn:endEvent id="st_end"/>
    <bpmn:endEvent id="st_end2"/>
  </bpmn:process>

  <!-- 5. A terminate end inside a sub-process ends the sub-process only. -->
  <bpmn:process id="rb_sub_terminate" isExecutable="true">
    <bpmn:startEvent id="sx_start"/>
    <bpmn:sequenceFlow id="sx_f0" sourceRef="sx_start" targetRef="sx_sub"/>
    <bpmn:subProcess id="sx_sub">
      <bpmn:startEvent id="sx_s_start"/>
      <bpmn:sequenceFlow id="sx_s_f0" sourceRef="sx_s_start" targetRef="sx_fork"/>
      <bpmn:parallelGateway id="sx_fork"/>
      <bpmn:sequenceFlow id="sx_s_f1" sourceRef="sx_fork" targetRef="sx_work"/>
      <bpmn:sequenceFlow id="sx_s_f2" sourceRef="sx_fork" targetRef="sx_stop"/>
      <bpmn:serviceTask id="sx_work"><bpmn:extensionElements><zeebe:taskDefinition type="rb-cut"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="sx_s_f3" sourceRef="sx_work" targetRef="sx_s_end"/>
      <bpmn:endEvent id="sx_s_end"/>
      <bpmn:serviceTask id="sx_stop"><bpmn:extensionElements><zeebe:taskDefinition type="rb-stop"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="sx_s_f4" sourceRef="sx_stop" targetRef="sx_term"/>
      <bpmn:endEvent id="sx_term"><bpmn:terminateEventDefinition/></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="sx_f1" sourceRef="sx_sub" targetRef="sx_after"/>
    <bpmn:serviceTask id="sx_after"><bpmn:extensionElements><zeebe:taskDefinition type="rb-after-sub"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="sx_f2" sourceRef="sx_after" targetRef="sx_end"/>
    <bpmn:endEvent id="sx_end"/>
  </bpmn:process>

  <!-- 6. A terminate end at the top ends the whole instance, the other branch too. -->
  <bpmn:process id="rb_terminate" isExecutable="true">
    <bpmn:startEvent id="tm_start"/>
    <bpmn:sequenceFlow id="tm_f0" sourceRef="tm_start" targetRef="tm_fork"/>
    <bpmn:parallelGateway id="tm_fork"/>
    <bpmn:sequenceFlow id="tm_f1" sourceRef="tm_fork" targetRef="tm_long"/>
    <bpmn:sequenceFlow id="tm_f2" sourceRef="tm_fork" targetRef="tm_quick"/>
    <bpmn:serviceTask id="tm_long"><bpmn:extensionElements><zeebe:taskDefinition type="rb-long"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="tm_f3" sourceRef="tm_long" targetRef="tm_end"/>
    <bpmn:endEvent id="tm_end"/>
    <bpmn:serviceTask id="tm_quick"><bpmn:extensionElements><zeebe:taskDefinition type="rb-quick"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="tm_f4" sourceRef="tm_quick" targetRef="tm_term"/>
    <bpmn:endEvent id="tm_term"><bpmn:terminateEventDefinition/></bpmn:endEvent>
  </bpmn:process>

  <!-- 7. Five parallel branches, one join. -->
  <bpmn:process id="rb_parallel_wide" isExecutable="true">
    <bpmn:startEvent id="pw_start"/>
    <bpmn:sequenceFlow id="pw_f0" sourceRef="pw_start" targetRef="pw_fork"/>
    <bpmn:parallelGateway id="pw_fork"/>
    <bpmn:sequenceFlow id="pw_a1" sourceRef="pw_fork" targetRef="pw_t1"/>
    <bpmn:sequenceFlow id="pw_a2" sourceRef="pw_fork" targetRef="pw_t2"/>
    <bpmn:sequenceFlow id="pw_a3" sourceRef="pw_fork" targetRef="pw_t3"/>
    <bpmn:sequenceFlow id="pw_a4" sourceRef="pw_fork" targetRef="pw_t4"/>
    <bpmn:sequenceFlow id="pw_a5" sourceRef="pw_fork" targetRef="pw_t5"/>
    <bpmn:serviceTask id="pw_t1"><bpmn:extensionElements><zeebe:taskDefinition type="rb-w1"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="pw_t2"><bpmn:extensionElements><zeebe:taskDefinition type="rb-w2"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="pw_t3"><bpmn:extensionElements><zeebe:taskDefinition type="rb-w3"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="pw_t4"><bpmn:extensionElements><zeebe:taskDefinition type="rb-w4"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="pw_t5"><bpmn:extensionElements><zeebe:taskDefinition type="rb-w5"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="pw_b1" sourceRef="pw_t1" targetRef="pw_join"/>
    <bpmn:sequenceFlow id="pw_b2" sourceRef="pw_t2" targetRef="pw_join"/>
    <bpmn:sequenceFlow id="pw_b3" sourceRef="pw_t3" targetRef="pw_join"/>
    <bpmn:sequenceFlow id="pw_b4" sourceRef="pw_t4" targetRef="pw_join"/>
    <bpmn:sequenceFlow id="pw_b5" sourceRef="pw_t5" targetRef="pw_join"/>
    <bpmn:parallelGateway id="pw_join"/>
    <bpmn:sequenceFlow id="pw_f1" sourceRef="pw_join" targetRef="pw_check"/>
    <bpmn:serviceTask id="pw_check"><bpmn:extensionElements><zeebe:taskDefinition type="rb-wide-check"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="pw_f2" sourceRef="pw_check" targetRef="pw_end"/>
    <bpmn:endEvent id="pw_end"/>
  </bpmn:process>

  <!-- 8. A parallel split inside a parallel branch. -->
  <bpmn:process id="rb_parallel_nested" isExecutable="true">
    <bpmn:startEvent id="pn_start"/>
    <bpmn:sequenceFlow id="pn_f0" sourceRef="pn_start" targetRef="pn_fork"/>
    <bpmn:parallelGateway id="pn_fork"/>
    <bpmn:sequenceFlow id="pn_f1" sourceRef="pn_fork" targetRef="pn_a"/>
    <bpmn:sequenceFlow id="pn_f2" sourceRef="pn_fork" targetRef="pn_fork2"/>
    <bpmn:serviceTask id="pn_a"><bpmn:extensionElements><zeebe:taskDefinition type="rb-n-a"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="pn_fork2"/>
    <bpmn:sequenceFlow id="pn_f3" sourceRef="pn_fork2" targetRef="pn_b1"/>
    <bpmn:sequenceFlow id="pn_f4" sourceRef="pn_fork2" targetRef="pn_b2"/>
    <bpmn:serviceTask id="pn_b1"><bpmn:extensionElements><zeebe:taskDefinition type="rb-n-b1"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="pn_b2"><bpmn:extensionElements><zeebe:taskDefinition type="rb-n-b2"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="pn_f5" sourceRef="pn_b1" targetRef="pn_join2"/>
    <bpmn:sequenceFlow id="pn_f6" sourceRef="pn_b2" targetRef="pn_join2"/>
    <bpmn:parallelGateway id="pn_join2"/>
    <bpmn:sequenceFlow id="pn_f7" sourceRef="pn_join2" targetRef="pn_join"/>
    <bpmn:sequenceFlow id="pn_f8" sourceRef="pn_a" targetRef="pn_join"/>
    <bpmn:parallelGateway id="pn_join"/>
    <bpmn:sequenceFlow id="pn_f9" sourceRef="pn_join" targetRef="pn_last"/>
    <bpmn:serviceTask id="pn_last"><bpmn:extensionElements><zeebe:taskDefinition type="rb-n-last"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="pn_f10" sourceRef="pn_last" targetRef="pn_end"/>
    <bpmn:endEvent id="pn_end"/>
  </bpmn:process>

  <!-- 9. An inclusive split, two of three true, then an inclusive join. -->
  <bpmn:process id="rb_inclusive_join" isExecutable="true">
    <bpmn:startEvent id="ij_start"/>
    <bpmn:sequenceFlow id="ij_f0" sourceRef="ij_start" targetRef="ij_fork"/>
    <bpmn:inclusiveGateway id="ij_fork"/>
    <bpmn:sequenceFlow id="ij_fa" sourceRef="ij_fork" targetRef="ij_a"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=wantA</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ij_fb" sourceRef="ij_fork" targetRef="ij_b"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=wantB</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ij_fc" sourceRef="ij_fork" targetRef="ij_c"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=wantC</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:serviceTask id="ij_a"><bpmn:extensionElements><zeebe:taskDefinition type="rb-i-a"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="ij_b"><bpmn:extensionElements><zeebe:taskDefinition type="rb-i-b"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="ij_c"><bpmn:extensionElements><zeebe:taskDefinition type="rb-i-c"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="ij_ga" sourceRef="ij_a" targetRef="ij_join"/>
    <bpmn:sequenceFlow id="ij_gb" sourceRef="ij_b" targetRef="ij_join"/>
    <bpmn:sequenceFlow id="ij_gc" sourceRef="ij_c" targetRef="ij_join"/>
    <bpmn:inclusiveGateway id="ij_join"/>
    <bpmn:sequenceFlow id="ij_f1" sourceRef="ij_join" targetRef="ij_after"/>
    <bpmn:serviceTask id="ij_after"><bpmn:extensionElements><zeebe:taskDefinition type="rb-i-after"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="ij_f2" sourceRef="ij_after" targetRef="ij_end"/>
    <bpmn:endEvent id="ij_end"/>
  </bpmn:process>

  <!-- 10. Link events: a throw jumps to the catch of the same name. -->
  <bpmn:process id="rb_links" isExecutable="true">
    <bpmn:startEvent id="lk_start"/>
    <bpmn:sequenceFlow id="lk_f0" sourceRef="lk_start" targetRef="lk_before"/>
    <bpmn:serviceTask id="lk_before"><bpmn:extensionElements><zeebe:taskDefinition type="rb-link-before"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="lk_f1" sourceRef="lk_before" targetRef="lk_throw"/>
    <bpmn:intermediateThrowEvent id="lk_throw"><bpmn:linkEventDefinition id="lk_def_t" name="ToTheEnd"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="lk_catch"><bpmn:linkEventDefinition id="lk_def_c" name="ToTheEnd"/></bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="lk_f2" sourceRef="lk_catch" targetRef="lk_after"/>
    <bpmn:serviceTask id="lk_after"><bpmn:extensionElements><zeebe:taskDefinition type="rb-link-after"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="lk_f3" sourceRef="lk_after" targetRef="lk_end"/>
    <bpmn:endEvent id="lk_end"/>
  </bpmn:process>

  <!-- 11. Two branches, each with its own end event: the instance ends with the last. -->
  <bpmn:process id="rb_two_ends" isExecutable="true">
    <bpmn:startEvent id="te_start"/>
    <bpmn:sequenceFlow id="te_f0" sourceRef="te_start" targetRef="te_fork"/>
    <bpmn:parallelGateway id="te_fork"/>
    <bpmn:sequenceFlow id="te_f1" sourceRef="te_fork" targetRef="te_fast"/>
    <bpmn:sequenceFlow id="te_f2" sourceRef="te_fork" targetRef="te_slow"/>
    <bpmn:serviceTask id="te_fast"><bpmn:extensionElements><zeebe:taskDefinition type="rb-e-fast"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="te_slow"><bpmn:extensionElements><zeebe:taskDefinition type="rb-e-slow"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="te_f3" sourceRef="te_fast" targetRef="te_end1"/>
    <bpmn:sequenceFlow id="te_f4" sourceRef="te_slow" targetRef="te_end2"/>
    <bpmn:endEvent id="te_end1"/>
    <bpmn:endEvent id="te_end2"/>
  </bpmn:process>

  <!-- 12. A FEEL script task feeding a service task. -->
  <bpmn:process id="rb_script" isExecutable="true">
    <bpmn:startEvent id="sc_start"/>
    <bpmn:sequenceFlow id="sc_f0" sourceRef="sc_start" targetRef="sc_compute"/>
    <bpmn:scriptTask id="sc_compute">
      <bpmn:extensionElements><zeebe:script expression="=sum(for line in lines return line.qty * line.price)" resultVariable="total"/></bpmn:extensionElements>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="sc_f1" sourceRef="sc_compute" targetRef="sc_show"/>
    <bpmn:serviceTask id="sc_show"><bpmn:extensionElements><zeebe:taskDefinition type="rb-script-show"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="sc_f2" sourceRef="sc_show" targetRef="sc_end"/>
    <bpmn:endEvent id="sc_end"/>
  </bpmn:process>

  <!-- 13. A DMN decision (robustness_discount.dmn) chooses the discount. -->
  <bpmn:process id="rb_dmn" isExecutable="true">
    <bpmn:startEvent id="dm_start"/>
    <bpmn:sequenceFlow id="dm_f0" sourceRef="dm_start" targetRef="dm_decide"/>
    <bpmn:businessRuleTask id="dm_decide">
      <bpmn:extensionElements><zeebe:calledDecision decisionId="rb_discount" resultVariable="discount"/></bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="dm_f1" sourceRef="dm_decide" targetRef="dm_show"/>
    <bpmn:serviceTask id="dm_show"><bpmn:extensionElements><zeebe:taskDefinition type="rb-dmn-show"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="dm_f2" sourceRef="dm_show" targetRef="dm_end"/>
    <bpmn:endEvent id="dm_end"/>
  </bpmn:process>

  <!-- 14. Big, nested and non-ASCII variables go through a job unchanged. -->
  <bpmn:process id="rb_big_vars" isExecutable="true">
    <bpmn:startEvent id="bv_start"/>
    <bpmn:sequenceFlow id="bv_f0" sourceRef="bv_start" targetRef="bv_echo"/>
    <bpmn:serviceTask id="bv_echo"><bpmn:extensionElements><zeebe:taskDefinition type="rb-echo"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="bv_f1" sourceRef="bv_echo" targetRef="bv_end"/>
    <bpmn:endEvent id="bv_end"/>
  </bpmn:process>

  <!-- 15. An escalation thrown inside a sub-process, caught without interrupting it. -->
  <bpmn:process id="rb_sub_escalation" isExecutable="true">
    <bpmn:startEvent id="sz_start"/>
    <bpmn:sequenceFlow id="sz_f0" sourceRef="sz_start" targetRef="sz_sub"/>
    <bpmn:subProcess id="sz_sub">
      <bpmn:startEvent id="sz_s_start"/>
      <bpmn:sequenceFlow id="sz_s_f0" sourceRef="sz_s_start" targetRef="sz_raise"/>
      <bpmn:intermediateThrowEvent id="sz_raise"><bpmn:escalationEventDefinition escalationRef="Esc_rb"/></bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="sz_s_f1" sourceRef="sz_raise" targetRef="sz_go_on"/>
      <bpmn:serviceTask id="sz_go_on"><bpmn:extensionElements><zeebe:taskDefinition type="rb-esc-continue"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="sz_s_f2" sourceRef="sz_go_on" targetRef="sz_s_end"/>
      <bpmn:endEvent id="sz_s_end"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="sz_catch" attachedToRef="sz_sub" cancelActivity="false"><bpmn:escalationEventDefinition escalationRef="Esc_rb"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="sz_f1" sourceRef="sz_sub" targetRef="sz_end"/>
    <bpmn:sequenceFlow id="sz_f2" sourceRef="sz_catch" targetRef="sz_notify"/>
    <bpmn:serviceTask id="sz_notify"><bpmn:extensionElements><zeebe:taskDefinition type="rb-esc-notify"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="sz_f3" sourceRef="sz_notify" targetRef="sz_end2"/>
    <bpmn:endEvent id="sz_end"/>
    <bpmn:endEvent id="sz_end2"/>
  </bpmn:process>

  <!-- 16. An error end event in a sub-process, caught on the sub-process. -->
  <bpmn:process id="rb_sub_error_end" isExecutable="true">
    <bpmn:startEvent id="sv_start"/>
    <bpmn:sequenceFlow id="sv_f0" sourceRef="sv_start" targetRef="sv_sub"/>
    <bpmn:subProcess id="sv_sub">
      <bpmn:startEvent id="sv_s_start"/>
      <bpmn:sequenceFlow id="sv_s_f0" sourceRef="sv_s_start" targetRef="sv_check"/>
      <bpmn:serviceTask id="sv_check"><bpmn:extensionElements><zeebe:taskDefinition type="rb-validate"/></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:sequenceFlow id="sv_s_f1" sourceRef="sv_check" targetRef="sv_gw"/>
      <bpmn:exclusiveGateway id="sv_gw" default="sv_s_bad"/>
      <bpmn:sequenceFlow id="sv_s_good" sourceRef="sv_gw" targetRef="sv_s_end"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="sv_s_bad" sourceRef="sv_gw" targetRef="sv_s_err"/>
      <bpmn:endEvent id="sv_s_end"/>
      <bpmn:endEvent id="sv_s_err"><bpmn:errorEventDefinition errorRef="Err_end"/></bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="sv_catch" attachedToRef="sv_sub"><bpmn:errorEventDefinition errorRef="Err_end"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="sv_f1" sourceRef="sv_sub" targetRef="sv_end"/>
    <bpmn:sequenceFlow id="sv_f2" sourceRef="sv_catch" targetRef="sv_recover"/>
    <bpmn:serviceTask id="sv_recover"><bpmn:extensionElements><zeebe:taskDefinition type="rb-recover"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="sv_f3" sourceRef="sv_recover" targetRef="sv_end2"/>
    <bpmn:endEvent id="sv_end"/>
    <bpmn:endEvent id="sv_end2"/>
  </bpmn:process>

  <!-- 17. Event-based gateway: a signal or a timer, whichever comes first. -->
  <bpmn:process id="rb_event_gw_signal" isExecutable="true">
    <bpmn:startEvent id="eg_start"/>
    <bpmn:sequenceFlow id="eg_f0" sourceRef="eg_start" targetRef="eg_gw"/>
    <bpmn:eventBasedGateway id="eg_gw"><bpmn:incoming>eg_f0</bpmn:incoming><bpmn:outgoing>eg_f1</bpmn:outgoing><bpmn:outgoing>eg_f2</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="eg_f1" sourceRef="eg_gw" targetRef="eg_signal"/>
    <bpmn:sequenceFlow id="eg_f2" sourceRef="eg_gw" targetRef="eg_timer"/>
    <bpmn:intermediateCatchEvent id="eg_signal"><bpmn:signalEventDefinition signalRef="Sig_rb"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="eg_timer">
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="eg_f3" sourceRef="eg_signal" targetRef="eg_by_signal"/>
    <bpmn:sequenceFlow id="eg_f4" sourceRef="eg_timer" targetRef="eg_by_timer"/>
    <bpmn:serviceTask id="eg_by_signal"><bpmn:extensionElements><zeebe:taskDefinition type="rb-by-signal"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="eg_by_timer"><bpmn:extensionElements><zeebe:taskDefinition type="rb-by-timer"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="eg_f5" sourceRef="eg_by_signal" targetRef="eg_end1"/>
    <bpmn:sequenceFlow id="eg_f6" sourceRef="eg_by_timer" targetRef="eg_end2"/>
    <bpmn:endEvent id="eg_end1"/>
    <bpmn:endEvent id="eg_end2"/>
  </bpmn:process>

  <!-- 18. A message correlated on a nested variable (order.id). -->
  <bpmn:process id="rb_nested_key" isExecutable="true">
    <bpmn:startEvent id="nk_start"/>
    <bpmn:sequenceFlow id="nk_f0" sourceRef="nk_start" targetRef="nk_prepare"/>
    <bpmn:serviceTask id="nk_prepare"><bpmn:extensionElements><zeebe:taskDefinition type="rb-prepare"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="nk_f1" sourceRef="nk_prepare" targetRef="nk_wait"/>
    <bpmn:intermediateCatchEvent id="nk_wait"><bpmn:messageEventDefinition messageRef="Msg_rb_nested"/></bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="nk_f2" sourceRef="nk_wait" targetRef="nk_after"/>
    <bpmn:serviceTask id="nk_after"><bpmn:extensionElements><zeebe:taskDefinition type="rb-after-message"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="nk_f3" sourceRef="nk_after" targetRef="nk_end"/>
    <bpmn:endEvent id="nk_end"/>
  </bpmn:process>

  <!-- 19. A multi-instance sub-process with a gateway inside and an output collection. -->
  <bpmn:process id="rb_mi_sub_gateway" isExecutable="true">
    <bpmn:startEvent id="mg_start"/>
    <bpmn:sequenceFlow id="mg_f0" sourceRef="mg_start" targetRef="mg_each"/>
    <bpmn:subProcess id="mg_each">
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=items" inputElement="item" outputCollection="sizes" outputElement="=size"/></bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="mg_s_start"/>
      <bpmn:sequenceFlow id="mg_s_f0" sourceRef="mg_s_start" targetRef="mg_gw"/>
      <bpmn:exclusiveGateway id="mg_gw" default="mg_s_small"/>
      <bpmn:sequenceFlow id="mg_s_big" sourceRef="mg_gw" targetRef="mg_big"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=item &gt; 10</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="mg_s_small" sourceRef="mg_gw" targetRef="mg_small"/>
      <bpmn:serviceTask id="mg_big">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="rb-mi-big"/>
          <zeebe:ioMapping><zeebe:output source="=&quot;big&quot;" target="size"/></zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="mg_small">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="rb-mi-small"/>
          <zeebe:ioMapping><zeebe:output source="=&quot;small&quot;" target="size"/></zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="mg_s_f1" sourceRef="mg_big" targetRef="mg_s_end1"/>
      <bpmn:sequenceFlow id="mg_s_f2" sourceRef="mg_small" targetRef="mg_s_end2"/>
      <bpmn:endEvent id="mg_s_end1"/>
      <bpmn:endEvent id="mg_s_end2"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="mg_f1" sourceRef="mg_each" targetRef="mg_end"/>
    <bpmn:endEvent id="mg_end"/>
  </bpmn:process>

  <!-- 20. A non-interrupting message boundary that fires twice while the task runs. -->
  <bpmn:process id="rb_boundary_twice" isExecutable="true">
    <bpmn:startEvent id="bt_start"/>
    <bpmn:sequenceFlow id="bt_f0" sourceRef="bt_start" targetRef="bt_work"/>
    <bpmn:serviceTask id="bt_work"><bpmn:extensionElements><zeebe:taskDefinition type="rb-bt-work"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:boundaryEvent id="bt_note" attachedToRef="bt_work" cancelActivity="false"><bpmn:messageEventDefinition messageRef="Msg_rb_note"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="bt_f1" sourceRef="bt_work" targetRef="bt_end"/>
    <bpmn:sequenceFlow id="bt_f2" sourceRef="bt_note" targetRef="bt_log"/>
    <bpmn:serviceTask id="bt_log"><bpmn:extensionElements><zeebe:taskDefinition type="rb-bt-log"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="bt_f3" sourceRef="bt_log" targetRef="bt_end2"/>
    <bpmn:endEvent id="bt_end"/>
    <bpmn:endEvent id="bt_end2"/>
  </bpmn:process>

  <!-- 21. A call activity whose child waits on a timer and maps its result back. -->
  <bpmn:process id="rb_call_timer" isExecutable="true">
    <bpmn:startEvent id="ct_start"/>
    <bpmn:sequenceFlow id="ct_f0" sourceRef="ct_start" targetRef="ct_call"/>
    <bpmn:callActivity id="ct_call">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="rb_call_timer_child" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=amount * 2" target="doubled"/>
          <zeebe:output source="=childResult" target="fromChild"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="ct_f1" sourceRef="ct_call" targetRef="ct_after"/>
    <bpmn:serviceTask id="ct_after"><bpmn:extensionElements><zeebe:taskDefinition type="rb-call-after"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="ct_f2" sourceRef="ct_after" targetRef="ct_end"/>
    <bpmn:endEvent id="ct_end"/>
  </bpmn:process>

  <bpmn:process id="rb_call_timer_child" isExecutable="true">
    <bpmn:startEvent id="cc_start"/>
    <bpmn:sequenceFlow id="cc_f0" sourceRef="cc_start" targetRef="cc_wait"/>
    <bpmn:intermediateCatchEvent id="cc_wait">
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="cc_f1" sourceRef="cc_wait" targetRef="cc_work"/>
    <bpmn:serviceTask id="cc_work"><bpmn:extensionElements><zeebe:taskDefinition type="rb-child-work"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="cc_f2" sourceRef="cc_work" targetRef="cc_end"/>
    <bpmn:endEvent id="cc_end"/>
  </bpmn:process>
</bpmn:definitions>
