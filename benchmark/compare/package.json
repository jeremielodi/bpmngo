{
  "name": "bpmngo-camunda-compare",
  "version": "1.0.0",
  "private": true,
  "description": "Runs the same BPMN scenarios on Camunda 8 and on BpmnGo through the Zeebe gRPC API, and reports every behaviour difference.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compare": "ts-node --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "load": "ts-node --transpile-only src/load.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
