<?xml version="1.0" encoding="UTF-8"?>
<!-- A Camunda user task completed over REST, and compensation. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="tasks_compensation" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:error id="Err_pay" errorCode="PAY"/>

  <bpmn:process id="ut_simple" isExecutable="true">
    <bpmn:startEvent id="u_start"/>
    <bpmn:sequenceFlow id="u_f0" sourceRef="u_start" targetRef="u_approve"/>
    <bpmn:userTask id="u_approve" name="Approve">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="demo"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="u_f1" sourceRef="u_approve" targetRef="u_after"/>
    <bpmn:serviceTask id="u_after"><bpmn:extensionElements><zeebe:taskDefinition type="ut-after"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="u_f2" sourceRef="u_after" targetRef="u_end"/>
    <bpmn:endEvent id="u_end"/>
  </bpmn:process>

  <!-- Book, then charge. A payment error triggers compensation: the
       completed booking is undone before the failure path goes on. -->
  <bpmn:process id="cp_booking" isExecutable="true">
    <bpmn:startEvent id="c_start"/>
    <bpmn:sequenceFlow id="c_f0" sourceRef="c_start" targetRef="c_book"/>
    <bpmn:serviceTask id="c_book"><bpmn:extensionElements><zeebe:taskDefinition type="cp-book"/></bpmn:extensionElements></bpmn:serviceTask>
    <!-- Camunda 8.10 fails the deploy with an NPE if a compensateEventDefinition has no id. -->
    <bpmn:boundaryEvent id="c_book_comp" attachedToRef="c_book"><bpmn:compensateEventDefinition id="c_book_comp_def"/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="c_undo" isForCompensation="true"><bpmn:extensionElements><zeebe:taskDefinition type="cp-undo"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="c_f1" sourceRef="c_book" targetRef="c_charge"/>
    <bpmn:serviceTask id="c_charge"><bpmn:extensionElements><zeebe:taskDefinition type="cp-charge"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:boundaryEvent id="c_pay_error" attachedToRef="c_charge"><bpmn:errorEventDefinition errorRef="Err_pay"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="c_f2" sourceRef="c_charge" targetRef="c_end"/>
    <bpmn:sequenceFlow id="c_f3" sourceRef="c_pay_error" targetRef="c_compensate"/>
    <bpmn:intermediateThrowEvent id="c_compensate"><bpmn:compensateEventDefinition id="c_compensate_def"/></bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="c_f4" sourceRef="c_compensate" targetRef="c_failed"/>
    <bpmn:serviceTask id="c_failed"><bpmn:extensionElements><zeebe:taskDefinition type="cp-failed"/></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="c_f5" sourceRef="c_failed" targetRef="c_end2"/>
    <bpmn:endEvent id="c_end"/>
    <bpmn:endEvent id="c_end2"/>
    <!-- Artifacts must follow all flow elements (BPMN 2.0 schema order). -->
    <bpmn:association id="c_assoc" associationDirection="One" sourceRef="c_book_comp" targetRef="c_undo"/>
  </bpmn:process>
</bpmn:definitions>
