<?xml version="1.0" encoding="UTF-8"?>
<!-- A first BpmnGo workflow: someone approves or rejects a request.
     Deploy and run it with scripts/demo.sh (see the readme's Quick Start). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="hello_world_defs" targetNamespace="http://bpmngo.io/examples">
  <bpmn:process id="hello_world" name="Hello World" isExecutable="true">
    <bpmn:startEvent id="request_received" name="Request received">
      <bpmn:outgoing>to_review</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="review_request" name="Review the request">
      <bpmn:incoming>to_review</bpmn:incoming>
      <bpmn:outgoing>to_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="decision" name="Approved?" default="to_rejected">
      <bpmn:incoming>to_decision</bpmn:incoming>
      <bpmn:outgoing>to_approved</bpmn:outgoing>
      <bpmn:outgoing>to_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="request_approved" name="Approved">
      <bpmn:incoming>to_approved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="request_rejected" name="Rejected">
      <bpmn:incoming>to_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="to_review" sourceRef="request_received" targetRef="review_request"/>
    <bpmn:sequenceFlow id="to_decision" sourceRef="review_request" targetRef="decision"/>
    <bpmn:sequenceFlow id="to_approved" name="yes" sourceRef="decision" targetRef="request_approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="to_rejected" name="no" sourceRef="decision" targetRef="request_rejected"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="hello_world_diagram">
    <bpmndi:BPMNPlane id="hello_world_plane" bpmnElement="hello_world">
      <bpmndi:BPMNShape id="request_received_di" bpmnElement="request_received">
        <dc:Bounds x="152" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="127" y="185" width="86" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_request_di" bpmnElement="review_request">
        <dc:Bounds x="250" y="120" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision" isMarkerVisible="true">
        <dc:Bounds x="435" y="135" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="432" y="111" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_approved_di" bpmnElement="request_approved">
        <dc:Bounds x="552" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="547" y="125" width="47" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_rejected_di" bpmnElement="request_rejected">
        <dc:Bounds x="552" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="548" y="245" width="45" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to_review_di" bpmnElement="to_review">
        <di:waypoint x="188" y="160"/><di:waypoint x="250" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_decision_di" bpmnElement="to_decision">
        <di:waypoint x="370" y="160"/><di:waypoint x="435" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_approved_di" bpmnElement="to_approved">
        <di:waypoint x="460" y="135"/><di:waypoint x="460" y="100"/><di:waypoint x="552" y="100"/>
        <bpmndi:BPMNLabel><dc:Bounds x="497" y="82" width="18" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_rejected_di" bpmnElement="to_rejected">
        <di:waypoint x="460" y="185"/><di:waypoint x="460" y="220"/><di:waypoint x="552" y="220"/>
        <bpmndi:BPMNLabel><dc:Bounds x="499" y="202" width="14" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
